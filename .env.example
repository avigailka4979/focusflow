# .env.example - copy to ".env" and fill in your values.
# Everything runs locally in docker compose (frontend, backend, MongoDB container).

# MongoDB container: use the SERVICE NAME from docker-compose.yml ("mongo"), not localhost.
MONGODB_URI=mongodb://mongo:27017
DB_NAME=focusflow

# Secret that signs login tokens (HS256). Any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, the server generates one on first start and keeps it in the database.
JWT_SECRET=

# Not used by this project. Submitted EMPTY.
GEMINI_API_KEY=
